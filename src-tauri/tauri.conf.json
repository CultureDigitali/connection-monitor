{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Connection Monitor",
  "version": "0.2.1",
  "identifier": "com.culturedigitali.connection-monitor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "vite",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Connection Monitor",
        "width": 340,
        "height": 540,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "visible": false,
        "hiddenTitle": true,
        "skipTaskbar": true,
        "x": 1100,
        "y": 30
      },
      {
        "label": "floating",
        "title": "",
        "width": 130,
        "height": 56,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "x": 100,
        "y": 100
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "public.app-category.utilities",
    "shortDescription": "Monitor your connection bandwidth and quality",
    "longDescription": "A beautiful, non-intrusive menu bar app that monitors your internet connection bandwidth, latency, jitter, and quality in real-time.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJFQjc2NEEzMTQ0OTM4MTQKUldRVU9Fa1VvMlMzdnVmSlB3NXYvMlB3S3FoS3FtT1ZrVUlVRVJqOWZNVWEzdUoyNzE0M09uRmYK",
      "endpoints": [
        "https://github.com/CultureDigitali/connection-monitor/releases/latest/download/latest.json"
      ]
    }
  }
}
